<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Primary destinations -->
    <fragment android:id="@+id/homeFragment"
        android:name="com.example.sportsapp.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment android:id="@+id/accountFragment"
        android:name="com.example.sportsapp.AccountFragment"
        android:label="Account"
        tools:layout="@layout/fragment_account" />

    <fragment android:id="@+id/profileFragment"
        android:name="com.example.sportsapp.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment android:id="@+id/mySportsFragment"
        android:name="com.example.sportsapp.MySportsFragment"
        android:label="My Sports"
        tools:layout="@layout/fragment_my_sports">
        <action android:id="@+id/action_mySports_to_football"
            app:destination="@id/footballFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action android:id="@+id/action_mySports_to_basketball"
            app:destination="@id/basketballFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action android:id="@+id/action_mySports_to_tennis"
            app:destination="@id/tennisFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Secondary destinations (sports) -->
    <fragment android:id="@+id/footballFragment"
        android:name="com.example.sportsapp.FootballFragment"
        android:label="Football"
        tools:layout="@layout/fragment_football" />

    <fragment android:id="@+id/basketballFragment"
        android:name="com.example.sportsapp.BasketballFragment"
        android:label="Basketball"
        tools:layout="@layout/fragment_basketball" />

    <fragment android:id="@+id/tennisFragment"
        android:name="com.example.sportsapp.TennisFragment"
        android:label="Tennis"
        tools:layout="@layout/fragment_tennis" />
</navigation>
